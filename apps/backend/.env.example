# Copy to .env; Next.js and Prisma both read this file.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/cntt-portal?schema=public
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Exact browser origins, separated by commas. Use the HTTPS web origin in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
